	journal = {Opt. Mater. Express},
	keywords = {Indium tin oxide; Material properties; Optical materials; Optical properties; Transparent conducting oxides; Wave propagation},
	number = {5},
	pages = {1222--1236},
	publisher = {Optica Publishing Group},
	title = {Time-varying media, dispersion, and the principle of causality},
