<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="all" type="LATEX_RUN_CONFIGURATION" factoryName="LaTeX configuration factory">
    <texify>
      <compiler>PDFLATEX</compiler>
      <compiler-path>$TeXLive$/pdflatex</compiler-path>
      <pdf-viewer>none</pdf-viewer>
      <require-focus>true</require-focus>
      <viewer-command />
      <compiler-arguments />
      <envs>
        <env name="PATH" value="$PATH$" />
      </envs>
      <expand-macros-in-environment-variables>true</expand-macros-in-environment-variables>
      <before-run-command />
      <main-file>$PROJECT_DIR$/template.tex</main-file>
      <output-path>$PROJECT_DIR$/out</output-path>
      <auxil-path>{projectDir}/auxil</auxil-path>
      <compile-twice>true</compile-twice>
      <output-format>PDF</output-format>
      <latex-distribution>PROJECT_SDK</latex-distribution>
      <has-been-run>true</has-been-run>
      <bib-run-config>[BibTeX.bibliography]</bib-run-config>
      <makeindex-run-config>[Makeindex.glossary]</makeindex-run-config>
    </texify>
    <method v="2" />
  </configuration>
</component>